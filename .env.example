# Copy to .env.local for local dev, or run: vercel env pull .env.local
# Validated at boot by src/lib/env.ts. Never commit real values.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en,lv,de

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio
SANITY_API_READ_TOKEN=            # viewer token: draft mode / visual editing
SANITY_API_WRITE_TOKEN=           # scripts/seeding only; not needed at runtime
SANITY_REVALIDATE_SECRET=         # webhook signature secret

# --- Shopify (Storefront API) ---
SHOPIFY_STORE_DOMAIN=             # your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN= # server-side requests
SHOPIFY_WEBHOOK_SECRET=

# --- Stripe (TEST keys outside production) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- Postgres (Neon via Vercel Marketplace) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=            # migrations

# --- Auth (back-office) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_ALLOWED_EMAIL_DOMAINS=      # optional, e.g. example.lv

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Travel Latvia <bookings@example.com>"
OPS_NOTIFICATION_EMAIL=

# --- Security / misc ---
MANAGE_BOOKING_TOKEN_SECRET=
CRON_SECRET=                      # Vercel Cron auth header

# --- Monitoring & analytics ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                # CI source-map upload

# --- Maps ---
NEXT_PUBLIC_MAPBOX_TOKEN=
