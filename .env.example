# Environment variables reference.
# Local dev: copy to .env.local, or run `vercel env pull .env.local`.
# Vercel pre-fills these names when importing the repo. The placeholder site
# needs none of them: add real values only when the phase that needs them starts.
# Values are intentionally empty; suggested values are in the comments.
# Names must not start with VERCEL_ (that prefix belongs to Vercel system variables).
# Validated at boot by src/lib/env.ts (Phase 1). Never commit real values.

# --- App (Phase 2) ---
# e.g. http://localhost:3000 locally; the production domain on Vercel
NEXT_PUBLIC_SITE_URL=
# e.g. en
NEXT_PUBLIC_DEFAULT_LOCALE=
# e.g. en,lv,de
NEXT_PUBLIC_LOCALES=

# --- Sanity (Phase 1) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
# staging for local and preview, production for production
NEXT_PUBLIC_SANITY_DATASET=
# e.g. 2026-09-01
NEXT_PUBLIC_SANITY_API_VERSION=
# e.g. /studio
NEXT_PUBLIC_SANITY_STUDIO_URL=
# Viewer token for draft mode and visual editing
SANITY_API_READ_TOKEN=
# Scripts and seeding only; not needed at runtime
SANITY_API_WRITE_TOKEN=
# Webhook signature secret
SANITY_REVALIDATE_SECRET=

# --- Shopify Storefront API (Phase 3) ---
# e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# e.g. 2026-07
SHOPIFY_STOREFRONT_API_VERSION=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Server-side requests
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Stripe (Phase 4; test keys everywhere except Production) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Postgres, Neon via Vercel Marketplace (Phase 1; set by the integration) ---
DATABASE_URL=
# Used for migrations
DATABASE_URL_UNPOOLED=

# --- Auth: only for the /admin fallback (ADR-010); Studio uses Sanity SSO ---
BETTER_AUTH_SECRET=
# e.g. http://localhost:3000
BETTER_AUTH_URL=
# Optional, e.g. example.lv
ADMIN_ALLOWED_EMAIL_DOMAINS=

# --- Email (Phase 4) ---
RESEND_API_KEY=
# e.g. Bookings <bookings@example.com>
EMAIL_FROM=
OPS_NOTIFICATION_EMAIL=

# --- Security (Phase 4) ---
MANAGE_BOOKING_TOKEN_SECRET=
# Vercel Cron authorisation header
CRON_SECRET=

# --- Monitoring (Phase 1) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# CI source-map upload
SENTRY_AUTH_TOKEN=

# --- Edge Config: redirects + announcement bar (ADR-012, Phase 2) ---
# Read connection string (set when Edge Config is connected to the project)
EDGE_CONFIG=
EDGE_CONFIG_ID=
# Vercel access token with write access to this Edge Config, used by the Sanity webhook
EDGE_CONFIG_WRITE_TOKEN=

# --- Tag management, marketer-managed (ADR-013, Phase 2) ---
NEXT_PUBLIC_GTM_ID=

# --- Maps (Phase 2) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
